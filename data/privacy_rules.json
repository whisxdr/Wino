        "value_type": "DWORD",
        "value_data": 0,
        "restore_data": 1
      }
    ]
  },
  {
    "id": "privacy_tailored_experiences",
    "name": "Tailored Experiences with Diagnostic Data",
    "description": "Stops Microsoft from using diagnostic data to show personalized recommendations, ads, and tips.",
    "category": "Privacy",
    "risk": "Safe",
    "reversible": true,
    "requires_admin": false,
    "supported_windows": ["10", "11"],
    "reason": "Disables personalized marketing suggestions inside Windows Settings and Notification center.",
    "impact": "Windows will not offer tips or product suggestions based on your usage.",
    "registry_keys": [
      {
        "hive": "HKCU",
        "path": "Software\\Policies\\Microsoft\\Windows\\CloudContent",
        "value_name": "DisableTailoredExperiencesWithDiagnosticData",
        "value_type": "DWORD",
        "value_data": 1,
        "restore_data": 0
      }
    ]
  },
  {
    "id": "privacy_inking_typing_personalization",
    "name": "Inking and Typing Personalization",
    "description": "Disables sending your typing and handwriting dictionary data to Microsoft cloud servers.",
    "category": "Privacy",
    "risk": "Safe",
    "reversible": true,
    "requires_admin": false,
    "supported_windows": ["10", "11"],
    "reason": "Prevents keystroke and handwriting samples from leaving the local machine.",
