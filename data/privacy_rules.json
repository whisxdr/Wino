    "registry_keys": [
      {
        "hive": "HKCU",
        "path": "Software\\Microsoft\\InputPersonalization",
        "value_name": "RestrictImplicitInkCollection",
        "value_type": "DWORD",
        "value_data": 1,
        "restore_data": 0
      },
      {
        "hive": "HKCU",
        "path": "Software\\Microsoft\\InputPersonalization",
        "value_name": "RestrictImplicitTextCollection",
        "value_type": "DWORD",
        "value_data": 1,
        "restore_data": 0
      }
    ]
  },
  {
    "id": "privacy_feedback_frequency",
    "name": "Feedback Frequency",
